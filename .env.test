# Non-secret defaults for integration tests (local docker-compose + CI).
# Real environment variables take precedence over this file.
DATABASE_URL=postgresql://opsdesk:opsdesk@localhost:5432/opsdesk_test?schema=public

# Tests run "behind a proxy" so each simulated client can have its own IP (X-Forwarded-For).
TRUST_PROXY_HOPS=1
