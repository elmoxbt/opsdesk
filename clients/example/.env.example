# ---------------------------------------------------------------------------
# Acme Plumbing: production environment. Copy to clients/<name>/.env on the VPS.
# deploy-client.sh generates any secret left as "generate" on first run.
# ---------------------------------------------------------------------------

# Public hostname (must match client.config.ts domains.app, or override it here).
# DNS A/AAAA records for APP_DOMAIN and FILES_DOMAIN must point at this server.
APP_DOMAIN=app.acme-plumbing.example
FILES_DOMAIN=files.acme-plumbing.example
# Email Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=ops@acme-plumbing.example

# ---- Secrets (generated on first deploy if left as "generate") ----
POSTGRES_PASSWORD=generate
JWT_ACCESS_SECRET=generate
S3_ACCESS_KEY=generate
S3_SECRET_KEY=generate
OWNER_INITIAL_PASSWORD=generate
# Encrypts webhook signing secrets at rest. Back it up with the database.
DATA_ENCRYPTION_KEY=generate

# ---- Online payments (only if features.payments is on) ----
# Paystack dashboard > Settings > API Keys & Webhooks. Use sk_test_... until go-live.
# Set the webhook URL there to https://<APP_DOMAIN>/api/webhooks/payments
PAYSTACK_SECRET_KEY=

# ---- Optional white-label overrides (see docs/deploying-a-client.md) ----
# CLIENT_APP_NAME=Acme Plumbing
# CLIENT_PRIMARY_COLOR=#0f766e
# FEATURE_BOOKING_PORTAL=false
# No Paystack account yet? Invoices still work without it (customers pay by transfer):
# FEATURE_PAYMENTS=false

# ---- Public demo deployments only: one-click sign-in buttons for the demo accounts ----
# Never on a real client. Pair with ./scripts/deploy-client.sh <client> --seed-demo.
# DEMO_LOGINS=true
# DEMO_PASSWORD=demo-password-123

# ---- Backups ----
BACKUP_RETENTION_DAYS=14
# Off-site copy (strongly recommended). Any S3-compatible bucket.
# BACKUP_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# BACKUP_S3_BUCKET=acme-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# ---- Monitoring (optional) ----
SENTRY_DSN=

# Server-local time for the nightly backup (BACKUP_HOUR, default 02).
TZ=Africa/Lagos
BACKUP_HOUR=02
