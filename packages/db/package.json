{
  "name": "@opsdesk/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "test": "vitest run",
    "test:integration": "dotenv -e ../../.env.test -- vitest run -c vitest.int.config.ts",
    "migrate:test": "dotenv -e ../../.env.test -- prisma migrate deploy",
    "bootstrap": "dotenv -e ../../.env -- tsx src/bootstrap.ts"
  },
  "dependencies": {
    "@prisma/client": "~6.16.2",
    "bcryptjs": "^3.0.2",
    "@opsdesk/client-config": "workspace:*",
    "@opsdesk/config": "workspace:*",
    "@opsdesk/shared": "workspace:*",
    "prisma": "~6.16.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4",
    "dotenv-cli": "^8.0.0"
  }
}
