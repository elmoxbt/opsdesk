# ---- Shared ----
NODE_ENV=development

# ---- Database / cache (matches docker-compose.yml) ----
DATABASE_URL=postgresql://opsdesk:opsdesk@localhost:5432/opsdesk?schema=public
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=4000
# Comma-separated. Also the allow-list for WebSocket handshakes.
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# ---- Web ----
# Socket.IO URL for the browser. Dev default: the API port (Next rewrites do not proxy WebSockets).
# Production: leave unset and route /socket.io to the API on the same origin.
# NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# ---- S3 / MinIO ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=opsdesk
S3_ACCESS_KEY=opsdesk
S3_SECRET_KEY=opsdesk-secret

# ---- Notifications ----
MAIL_PROVIDER=console
MAIL_FROM="OpsDesk <no-reply@opsdesk.local>"

# ---- Monitoring (optional; Sentry is disabled when empty) ----
SENTRY_DSN=

# ---- Background jobs ----
# inline = run in the API process (dev/tests, no Redis needed). Production uses
# bullmq: the API enqueues, the `worker` container (RUN_WORKER=true) processes.
QUEUE_DRIVER=inline
RUN_WORKER=false

# ---- Invoices & payments ----
# Public URL of the web app: pay links in emails/PDFs and the gateway's return URL.
APP_URL=http://localhost:3000
# fake = built-in test checkout (no account needed; refused in production).
# paystack = real gateway; set PAYSTACK_SECRET_KEY (sk_test_... or sk_live_...) and point
# the Paystack dashboard webhook at https://<your domain>/api/webhooks/payments
PAYMENTS_MODE=fake
PAYSTACK_SECRET_KEY=

# Reverse proxies in front of the API whose X-Forwarded-For is trusted (for per-IP limits).
# 0 locally; the production compose file sets 1 (Caddy).
TRUST_PROXY_HOPS=0

# ---- Public API (publicApi feature) ----
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts webhook secrets at rest; required in production.
DATA_ENCRYPTION_KEY=
# Scales every rate limit (an office sharing one IP, or an e2e rig where all traffic is localhost).
RATE_LIMIT_MULTIPLIER=1

# ---- Demo deployments: one-click sign-in buttons on /login (never for a real client) ----
DEMO_LOGINS=true

# ---- White-label bootstrap (see config/client.config.ts) ----
# Initial password for the owner account that `pnpm db:bootstrap` creates.
# Only used the first time; existing passwords are never overwritten.
OWNER_INITIAL_PASSWORD=demo-password-123
# Optional runtime overrides of config/client.config.ts, e.g.:
# CLIENT_PRIMARY_COLOR=#0f766e
# FEATURE_ANALYTICS=false
